{
  "name": "nest-native-jobs-showcase",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end showcase for @nest-native/jobs: transactional enqueue → @JobHandler dispatch → retries, delays, unique jobs and a graceful worker loop, on SQLite",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "ts-node --transpile-only scripts/smoke.ts",
    "test": "npm run typecheck && npm run smoke"
  },
  "dependencies": {
    "@nest-native/jobs": "0.3.0",
    "@nestjs-cls/transactional": "^3.2.2",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "^1.4.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "nestjs-cls": "^6.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
